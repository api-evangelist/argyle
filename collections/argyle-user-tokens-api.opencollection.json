{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argyle Accounts User Tokens API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a user token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.argyle.com/v2/user-tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new user token from the `id` of an existing user for direct embedded Link initializations.\n\n<Note>\n[Creating a new user](/api-reference/users#create) will also return a user token in the response.\n</Note>\n"
        }
      ]
    }
  ],
  "bundled": true
}