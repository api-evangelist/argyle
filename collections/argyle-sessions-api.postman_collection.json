          "name": "Create a session",
          "request": {
            "name": "Create a session",
            "description": {
              "content": "Create a connection session and return a `link` URL that launches the frontend experience.\n\nSession links expire after one hour. A new session link can be created at any time by creating another session for the active verification.\n\n<Note>This endpoint is for payroll and banking verifications only.</Note>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
