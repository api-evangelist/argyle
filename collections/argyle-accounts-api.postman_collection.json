        {
          "id": "3c4c622c-a895-4e4a-802c-373e91fcf53f",
          "name": "Disable account updates",
          "request": {
            "name": "Disable account updates",
            "description": {
              "content": "Disables `ongoing_refresh` for an individual account.\n\nTo access this feature, reach out to our team for assistance.\n\n*   Link will display the [ongoing\\_refresh\\_disabled](/api-reference/account-connection-errors#ongoingrefreshdisabled) account connection error when users return to view this account.\n*   Changes the account's [`ongoing_refresh.status`](/api-reference/accounts#object-ongoing_refresh) value from `enabled` to `disabled` and causes the [`accounts.updated`](/api-reference/accounts-webhooks/updated) webhook to be sent.\n\n<br/>\n\nAfter `ongoing_refresh` is disabled:\n\n*   The specified account will no longer receive [data updates](/overview/ongoing-refresh).\n*   If the user returns to Link and [reconnects the account](/workflows/reconnecting-accounts#reconnecting-disconnected-accounts):\n    1.  The account will immediately be re-scanned and its data updated.\n    2.  The account will be billed as a new account connection.\n    3.  Ongoing refresh will be re-enabled for the account.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":id",
                "disable-ongoing-refresh"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) ID of the account object."
                }
              ]
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "302fc940-a1ad-4347-b603-e17112d3a33f",
