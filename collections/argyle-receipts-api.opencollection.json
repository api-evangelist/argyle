{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argyle Accounts Receipts API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Receipts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a receipt",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.argyle.com/v2/receipts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a PDF listing all billable transactions associated with the user."
        }
      ]
    }
  ],
  "bundled": true
}